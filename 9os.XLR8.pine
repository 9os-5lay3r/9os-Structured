// ------------------------------------------------------------------------------------ MODULE A · ICT HTF Candles
var array<Candle> candles_1 = array.new<Candle>(0)
var array<Candle> candles_2 = array.new<Candle>(0)
var array<Candle> candles_3 = array.new<Candle>(0)
var array<Candle> candles_4 = array.new<Candle>(0)
var array<Candle> candles_5 = array.new<Candle>(0)
var array<Candle> candles_6 = array.new<Candle>(0)

var array<Imbalance> imbalances_1 = array.new<Imbalance>()
var array<Imbalance> imbalances_2 = array.new<Imbalance>()
var array<Imbalance> imbalances_3 = array.new<Imbalance>()
var array<Imbalance> imbalances_4 = array.new<Imbalance>()
var array<Imbalance> imbalances_5 = array.new<Imbalance>()
var array<Imbalance> imbalances_6 = array.new<Imbalance>()

// [merge] one array of sets replaces the six htf1..htf6 variables, so the execution block can loop over them
var array<CandleSet> htfSets = array.new<CandleSet>()
if barstate.isfirst
    array.push(htfSets, CandleSet.new(candles_1, imbalances_1, SettingsHTF1))
    array.push(htfSets, CandleSet.new(candles_2, imbalances_2, SettingsHTF2))
    array.push(htfSets, CandleSet.new(candles_3, imbalances_3, SettingsHTF3))
    array.push(htfSets, CandleSet.new(candles_4, imbalances_4, SettingsHTF4))
    array.push(htfSets, CandleSet.new(candles_5, imbalances_5, SettingsHTF5))
    array.push(htfSets, CandleSet.new(candles_6, imbalances_6, SettingsHTF6))

var Trace trace = Trace.new()

// ------------------------------------------------------------------------------- MODULE B · Smart Money Concepts
var pivot swingHigh                 = pivot.new(na, na, false)
var pivot swingLow                  = pivot.new(na, na, false)
var pivot internalHigh              = pivot.new(na, na, false)
var pivot internalLow               = pivot.new(na, na, false)
var pivot equalHigh                 = pivot.new(na, na, false)
var pivot equalLow                  = pivot.new(na, na, false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs        = array.new<float>()
var array<float> parsedLows         = array.new<float>()
var array<float> highs              = array.new<float>()
var array<float> lows               = array.new<float>()
var array<int> times                = array.new<int>()
var trailingExtremes trailing       = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time

// we create the needed boxes for displaying order blocks at the first execution
if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            array.push(swingOrderBlocksBoxes, box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            array.push(internalOrderBlocksBoxes, box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right))

// we store current values into the arrays at each bar
array.push(parsedHighs, parsedHigh)
array.push(parsedLows, parsedLow)
array.push(highs, high)
array.push(lows, low)
array.push(times, time)
//+==============================================================================================================+//
//+---  7 · FUNCTIONS   ·   MODULE B · Smart Money Concepts                                                  ---+//
//+==============================================================================================================+//

// @function            Get the value of the current leg, it can be 0 (bearish) or 1 (bullish)
// @returns             int
leg(int size) =>
    var int legValue    = 0
    newLegHigh          = high[size] > ta.highest(size)
    newLegLow           = low[size]  < ta.lowest(size)

    if newLegHigh
        legValue := BEARISH_LEG
    else if newLegLow
        legValue := BULLISH_LEG
    legValue

// @function            Identify whether the current value is the start of a new leg (swing)
// @param legValue      (int) Current leg value
// @returns             bool
startOfNewLeg(int legValue)      => ta.change(legValue) != 0

// @function            Identify whether the current level is the start of a new bearish leg (swing)
// @param legValue      (int) Current leg value
// @returns             bool
startOfBearishLeg(int legValue)  => ta.change(legValue) == -1

// @function            Identify whether the current level is the start of a new bullish leg (swing)
// @param legValue      (int) Current leg value
// @returns             bool
startOfBullishLeg(int legValue)  => ta.change(legValue) == +1

// @function            create a new label
// @param labelTime     bar time coordinate
// @param labelPrice    price coordinate
// @param tag           text to display
// @param labelColor    text color
// @param labelStyle    label style
// @returns             label ID
drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na

    if theme.show_smc and modeInput == PRESENT
        label.delete(l_abel)

    if theme.show_smc
        l_abel := label.new(chart.point.new(labelTime, na, labelPrice), tag, xloc = xloc.bar_time, color = color(na), textcolor = labelColor, style = labelStyle, size = size.small)

    if not theme.show_smc and not na(l_abel)
        label.delete(l_abel)
        l_abel := na

    l_abel

// @function            create a new line and label representing an EQH or EQL
// @param p_ivot        starting pivot
// @param level         price level of current pivot
// @param size          how many bars ago was the current pivot detected
// @param equalHigh     true for EQH, false for EQL
// @returns             label ID
drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay

    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    // EQH / EQL are detected on every bar now, this is where the display is decided
    bool drawing = theme.show_smc and showEqualHighsLowsInput

    if drawing and modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)

    if drawing
        e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time[size], na, level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
        labelPosition           = math.round(0.5 * (p_ivot.barIndex + bar_index - size))
        e_qualDisplay.l_abel    := label.new(chart.point.new(na, labelPosition, level), tag, xloc = xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

    if not drawing and not na(e_qualDisplay.l_ine)
        line.delete(    e_qualDisplay.l_ine)
        e_qualDisplay.l_ine := na
    if not drawing and not na(e_qualDisplay.l_abel)
        label.delete(   e_qualDisplay.l_abel)
        e_qualDisplay.l_abel := na

    e_qualDisplay.l_abel

// @function            store current structure and trailing swing points, and also display swing points and equal highs/lows
// @param size          (int) structure size
// @param equalHighLow  (bool) true for displaying current highs/lows
// @param internal      (bool) true for getting internal structures
// @returns             void
getCurrentStructure(int size, bool equalHighLow = false, bool internal = false) =>
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, high[size], size, true)
                currentAlerts.equalHighs := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

// @function                draw line and label representing a structure
// @param p_ivot            base pivot point
// @param tag               test to display
// @param structureColor    base color
// @param lineStyle         line style
// @param labelStyle        label style
// @param labelSize         text size
// @returns                 void
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>
    var line l_ine      = line.new(na, na, na, na, xloc = xloc.bar_time)
    var label l_abel    = label.new(na, na)

    if theme.show_smc and modeInput == PRESENT
        line.delete(l_ine)
        label.delete(l_abel)

    if theme.show_smc
        l_ine   := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time, na, p_ivot.currentLevel), xloc.bar_time, color = structureColor, style = lineStyle)
        l_abel  := label.new(chart.point.new(na, math.round(0.5 * (p_ivot.barIndex + bar_index)), p_ivot.currentLevel), tag, xloc = xloc.bar_index, color = color(na), textcolor = structureColor, style = labelStyle, size = labelSize)

    if not theme.show_smc and not na(l_ine)
        line.delete(l_ine)
        l_ine := na
    if not theme.show_smc and not na(l_abel)
        label.delete(l_abel)
        l_abel := na

// @function            delete order blocks
// @param internal      true for internal order blocks
// @returns             void
deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    for [index, eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false

        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock
            array.remove(orderBlocks, index)

// @function            fetch and store order blocks
// @param p_ivot        base pivot point
// @param internal      true for internal order blocks
// @param bias          BULLISH or BEARISH
// @returns             void
storeOrdeBlock(pivot p_ivot, bool internal = false, int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)

        // [v6] guard kept from the original: a pivot on the current bar gave an empty slice, and array.max() /
        // array.min() on an empty slice is not defined
        int parsedIndex = p_ivot.barIndex

        if p_ivot.barIndex < bar_index
            if bias == BEARISH
                array<float> a_rray = array.slice(parsedHighs, p_ivot.barIndex, bar_index)
                parsedIndex := p_ivot.barIndex + array.indexof(a_rray, array.max(a_rray))
            else
                array<float> a_rray = array.slice(parsedLows, p_ivot.barIndex, bar_index)
                parsedIndex := p_ivot.barIndex + array.indexof(a_rray, array.min(a_rray))

        orderBlock o_rderBlock          = orderBlock.new(array.get(parsedHighs, parsedIndex), array.get(parsedLows, parsedIndex), array.get(times, parsedIndex), bias)
        array<orderBlock> orderBlocks   = internal ? internalOrderBlocks : swingOrderBlocks

        if orderBlocks.size() >= 100
            array.pop(orderBlocks)
        array.unshift(orderBlocks, o_rderBlock)

// @function            draw order blocks as boxes
// @param internal      true for internal order blocks
// @returns             void
drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()
    array<box> b_oxes                   = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
    bool allowed    = theme.show_smc and (internal ? showInternalOrderBlocksInput : showSwingOrderBlocksInput)

    // the boxes are pre-created for this list, so they are dropped when the list is not drawn
    if not allowed
        for eachBox in b_oxes
            box.delete(eachBox)
        array.clear(b_oxes)

    if allowed and orderBlocksSize > 0
        maxOrderBlocks                      = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks  = array.slice(orderBlocks, 0, math.min(maxOrderBlocks, orderBlocksSize))

        for [index, eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = theme.smc_style == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH, 80) : color.new(MONO_BULLISH, 80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)

            box b_ox        = array.get(b_oxes, index)
            box.set_top_left_point(     b_ox, chart.point.new(eachOrderBlock.barTime, na, eachOrderBlock.barHigh))
            box.set_bottom_right_point( b_ox, chart.point.new(last_bar_time, na, eachOrderBlock.barLow))
            box.set_border_color(       b_ox, internal ? na : orderBlockColor)
            box.set_bgcolor(            b_ox, orderBlockColor)

// @function            draw one fair value gap box (each fair value gap has two boxes)
// @param leftTime      left time coordinate
// @param rightTime     right time coordinate
// @param topPrice      top price level
// @param bottomPrice   bottom price level
// @param boxColor      box color
// @returns             box ID
fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) => box.new(chart.point.new(leftTime, na, topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * (time - time[1]), na, bottomPrice), xloc = xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

// @function            delete fair value gaps
// @returns             void
deleteFairValueGaps() =>
    for [index, eachFairValueGap] in fairValueGaps
        if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
            box.delete(eachFairValueGap.topBox)
            box.delete(eachFairValueGap.bottomBox)
            array.remove(fairValueGaps, index)

// @function            draw fair value gaps
// @returns             void
drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    // gaps are calculated on every bar (ta.cum and timeframe.change above need that), this decides the drawing
    bool allowed = theme.show_smc and showFairValueGapsInput

    if not allowed and array.size(fairValueGaps) > 0
        array<fairValueGap> oldGaps = array.copy(fairValueGaps)
        array.clear(fairValueGaps)
        for eachOldGap in oldGaps
            box.delete(eachOldGap.topBox)
            box.delete(eachOldGap.bottomBox)

    if allowed and bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        array.unshift(fairValueGaps, fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, math.avg(currentLow, last2High), fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentLow, last2High), last2High, fairValueGapBullishColor)))
    if allowed and bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        array.unshift(fairValueGaps, fairValueGap.new(currentHigh, last2Low, BEARISH, fairValueGapBox(lastTime, currentTime, currentHigh, math.avg(currentHigh, last2Low), fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentHigh, last2Low), last2Low, fairValueGapBearishColor)))

// @function            get line style from string
// @param style         line style
// @returns             string
getStyle(string style) =>
    switch style
        SOLID   => line.style_solid
        DASHED  => line.style_dashed
        DOTTED  => line.style_dotted
        // [v6] the original had no default branch; v6 requires one for unique types
        => line.style_solid

// @function            draw MultiTimeFrame levels
// @param htf           base timeframe
// @param sameTimeframe true if chart timeframe is same as base timeframe
// @param style         line style
// @param levelColor    line and text color
// @returns             void
drawLevels(string htf, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, htf, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = array.binary_search_rightmost(times, parsedLeftTime)
        int rightIndex              = array.binary_search_rightmost(times, parsedRightTime)

        // [v6] only slice a non empty range
        if rightIndex > leftIndex
            array<int> timeArray        = array.slice(times, leftIndex, rightIndex)
            array<float> topArray       = array.slice(highs, leftIndex, rightIndex)
            array<float> bottomArray    = array.slice(lows, leftIndex, rightIndex)

            parsedTopTime               := array.get(timeArray, array.indexof(topArray, array.max(topArray)))
            parsedBottomTime            := array.get(timeArray, array.indexof(bottomArray, array.min(bottomArray)))

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H', htf), color = color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L', htf), color = color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    int rightBarTime = last_bar_time + 20 * (time - time[1])

    if theme.show_smc
        line.set_first_point(   topLine, chart.point.new(parsedTopTime, na, parsedTop))
        line.set_second_point(  topLine, chart.point.new(rightBarTime, na, parsedTop))
        label.set_point(        topLabel, chart.point.new(rightBarTime, na, parsedTop))

        line.set_first_point(   bottomLine, chart.point.new(parsedBottomTime, na, parsedBottom))
        line.set_second_point(  bottomLine, chart.point.new(rightBarTime, na, parsedBottom))
        label.set_point(        bottomLabel, chart.point.new(rightBarTime, na, parsedBottom))

    if not theme.show_smc and not na(topLine)
        line.delete(topLine)
        topLine := na
    if not theme.show_smc and not na(bottomLine)
        line.delete(bottomLine)
        bottomLine := na
    if not theme.show_smc and not na(topLabel)
        label.delete(topLabel)
        topLabel := na
    if not theme.show_smc and not na(bottomLabel)
        label.delete(bottomLabel)
        bottomLabel := na

// @function            true if chart timeframe is higher than provided timeframe
// @param htf           timeframe to check
// @returns             bool
higherTimeframe(string htf) => timeframe.in_seconds() > timeframe.in_seconds(htf)

// @function            update trailing swing points
// @returns             void
updateTrailingExtremes() =>
    // [merge] na-safe: the original started from na fields and math.max/min propagate na
    trailing.top            := na(trailing.top) ? high : math.max(high, trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := na(trailing.bottom) ? low : math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

// @function            draw trailing swing points
// @returns             void
drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color = color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color = color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    if not theme.show_smc and not na(topLine)
        line.delete(topLine)
        topLine := na
    if not theme.show_smc and not na(bottomLine)
        line.delete(bottomLine)
        bottomLine := na
    if not theme.show_smc and not na(topLabel)
        label.delete(topLabel)
        topLabel := na
    if not theme.show_smc and not na(bottomLabel)
        label.delete(bottomLabel)
        bottomLabel := na

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    if theme.show_smc
        line.set_first_point(   topLine, chart.point.new(trailing.lastTopTime, na, trailing.top))
        line.set_second_point(  topLine, chart.point.new(rightTimeBar, na, trailing.top))
        label.set_point(        topLabel, chart.point.new(rightTimeBar, na, trailing.top))
        label.set_text(         topLabel, swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

        line.set_first_point(   bottomLine, chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
        line.set_second_point(  bottomLine, chart.point.new(rightTimeBar, na, trailing.bottom))
        label.set_point(        bottomLabel, chart.point.new(rightTimeBar, na, trailing.bottom))
        label.set_text(         bottomLabel, swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

// @function            draw a zone with a label and a box
// @param labelLevel    price level for label
// @param labelIndex    bar index for label
// @param top           top price level for box
// @param bottom        bottom price level for box
// @param tag           text to display
// @param zoneColor     base color
// @param style         label style
// @returns             void
drawZone(float labelLevel, labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na, na, text = tag, color = color(na), textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na, na, na, na, bgcolor = color.new(zoneColor, 80), border_color = color(na), xloc = xloc.bar_time)

    if theme.show_smc
        box.set_top_left_point(     b_ox, chart.point.new(trailing.barTime, na, top))
        box.set_bottom_right_point( b_ox, chart.point.new(last_bar_time, na, bottom))

        label.set_point(            l_abel, chart.point.new(na, labelIndex, labelLevel))

    if not theme.show_smc and not na(b_ox)
        box.delete(b_ox)
        b_ox := na
    if not theme.show_smc and not na(l_abel)
        label.delete(l_abel)
        l_abel := na

// @function            draw premium/discount zones
// @returns             void
drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5 * (trailing.barIndex + last_bar_index)), trailing.top, 0.95 * trailing.top + 0.05 * trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525 * trailing.top + 0.475 * trailing.bottom, 0.525 * trailing.bottom + 0.475 * trailing.top, 'Equilibrium', equilibriumZoneColor, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5 * (trailing.barIndex + last_bar_index)), 0.95 * trailing.bottom + 0.05 * trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

// @function            detect and draw structures, also detect and store order blocks
// @param internal      true for internal structures or order blocks
// @returns             void
displayStructure(bool internal = false) =>
    var bool bullishBar = true
    var bool bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)

    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = internal ? internalBullColorInput : swingBullishColor

    if ta.crossover(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH  := tag == CHOCH
            currentAlerts.internalBullishBOS    := tag == BOS
        else
            currentAlerts.swingBullishCHoCH     := tag == CHOCH
            currentAlerts.swingBullishBOS       := tag == BOS

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BULLISH)

    p_ivot          := internal ? internalLow : swingLow
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = internal ? internalBearColorInput : swingBearishColor

    if ta.crossunder(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH  := tag == CHOCH
            currentAlerts.internalBearishBOS    := tag == BOS
        else
            currentAlerts.swingBearishCHoCH     := tag == CHOCH
            currentAlerts.swingBearishBOS       := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))

        if displayCondition
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BEARISH)
//+==============================================================================================================+//
//+---  8 · FUNCTIONS   ·   MODULE A · ICT HTF Candles                                                       ---+//
//+==============================================================================================================+//

// @function            map an input style string to a Pine line style
LineStyle(string style) =>
    switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid

// @function            day of week letter, index 1 = Monday
DowLetter(int index) =>
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
        index == 5 => 'F'
        index == 6 => 'S'
        index == 7 => 'S'
        => ''

// @function            a higher timeframe can only be drawn when it is >= 1D, or an integer multiple of the chart
ValidTimeframe(string htf) =>
    int chartSec = timeframe.in_seconds()
    int htfSec   = timeframe.in_seconds(htf)
    if htfSec >= 86400 and htfSec > chartSec
        true
    else
        chartSec < htfSec and math.round(htfSec / chartSec) == htfSec / chartSec

// @function            remaining time until the current HTF candle closes
RemainingTime(string htf) =>
    if barstate.isrealtime
        float timeRemaining = (time_close(htf) - timenow) / 1000
        days    = math.floor(timeRemaining / 86400)
        hours   = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)

        string r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'

// @function            "5m" / "4H" / "1D" style name of a timeframe
HTFName(string htf) =>
    int sec     = timeframe.in_seconds(htf)
    string res  = ''
    if sec < 60
        res := str.tostring(sec) + 's'
    else if sec < 3600
        res := str.tostring(math.round(sec / 60)) + 'm'
    else if sec < 86400
        res := str.tostring(math.round(sec / 3600)) + 'H'
    else if sec < 604800
        res := str.tostring(math.round(sec / 86400)) + 'D'
    else if sec < 2592000
        res := str.tostring(math.round(sec / 604800)) + 'W'
    else
        res := str.tostring(math.round(sec / 2592000)) + 'M'
    res

// @function            text of the "Interval Value" stamp of one HTF candle
// [merge] works for every timeframe (the original only handled sub-daily HTFs correctly)
IntervalText(int barTime, string htf) =>
    int sec     = timeframe.in_seconds(htf)
    string res  = ''
    if sec < 86400
        res := str.format_time(barTime, 'HH:mm', SESSION_TZ)
    else if sec < 604800
        // the original stamped the daily candle with the trading day of the chart bar that opened it
        res := DowLetter(dayofweek(time_tradingday, SESSION_TZ))
    else
        res := str.format_time(barTime, 'MM/dd', SESSION_TZ)
    res

// @function            New York midnight of the day a bar time belongs to
DayStamp(int barTime) =>
    timestamp(SESSION_TZ, year(barTime, SESSION_TZ), month(barTime, SESSION_TZ), dayofmonth(barTime, SESSION_TZ), 0, 0)

// @function            true when the current bar is at or past the custom daily open of its New York day
DailyAdjust(int barTime) =>
    int targetSec = switch settings.custom_daily
        '8:30'  => 30600
        '9:30'  => 34200
        => 0
    barTime >= DayStamp(barTime) + targetSec * 1000

// @function            midpoint of one candle, the anchor of the "Candle Height" scaling
CandleMid(Candle c) => (c.h + c.l) / 2

// @function            y coordinate a price is drawn at for one candle, after the "Candle Height" scaling
// [merge] new: settings.height = 1 returns the price untouched, so the default picture is exactly as before
CandleY(Candle c, float price) => CandleMid(c) + (price - CandleMid(c)) * settings.height

// @function            highest high of one set of candles
CandleSetHigh(array<Candle> candles, float start) =>
    float res = start
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c    = array.get(candles, i)
            float drawn = CandleY(c, c.h)
            if drawn > res
                res := drawn
    res

// @function            lowest low of one set of candles
CandleSetLow(array<Candle> candles, float start) =>
    float res = start
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c    = array.get(candles, i)
            float drawn = CandleY(c, c.l)
            if drawn < res
                res := drawn
    res

// @function            highest high across every displayed HTF set ("Align" label alignment)
ActiveHigh(array<int> active) =>
    float res = 0.0
    for i in active
        res := CandleSetHigh(array.get(htfSets, i).candles, res)
    res

// @function            lowest low across every displayed HTF set ("Align" label alignment)
ActiveLow(array<int> active, float start) =>
    float res = start
    for i in active
        res := CandleSetLow(array.get(htfSets, i).candles, res)
    res

// @function            indexes (in htfSets) of the sets that are drawn on this bar
// [merge] one place decides what is on the chart, so labels, offsets and the trace anchor always agree
ActiveSetIndexes() =>
    array<int> res = array.new<int>()
    for [i, candleSet] in htfSets
        if res.size() >= settings.max_sets
            break
        if candleSet.settings.show and ValidTimeframe(candleSet.settings.htf)
            array.push(res, i)
    res

// @function            true when the CRT engine runs for this row
CrtEnabled(CandleSet candleSet) =>
    candleSet.settings.crt and (settings.crt_min == 'Any timeframe' or timeframe.in_seconds(candleSet.settings.htf) >= 3600)

// @function            index of the candle currently flagged as the range candle (candle 1), -1 if none
CrtRangeIndex(array<Candle> candles) =>
    int res = -1
    for i = 0 to array.size(candles) - 1
        if array.get(candles, i).crt_num == 1
            res := i
            break
    res

// @function            index of the candle flagged as candle 2 (the sweep + reclaim candle), -1 if none
CrtConfirmIndex(array<Candle> candles) =>
    int res = -1
    for i = 0 to array.size(candles) - 1
        if array.get(candles, i).crt_num == 2
            res := i
            break
    res

// @function            drop every CRT number and its badge, used when a range is replaced or CRT is switched off
ClearCrtNumbers(CandleSet candleSet) =>
    if array.size(candleSet.candles) > 0
        for i = 0 to array.size(candleSet.candles) - 1
            Candle c = array.get(candleSet.candles, i)
            if c.crt_num > 0
                c.crt_num := 0
                if not na(c.crt_label)
                    label.delete(c.crt_label)
                    c.crt_label := na

// @function            CRT high / low of the active range candle
// [merge] new rule: nothing is drawn until a later candle has swept the high or the low of the range candle
// AND closed back inside its range (that candle becomes candle 2). The levels belong to candle 1 and are
// removed the moment a candle closes outside its range, because the "1" then moves to that candle.
DrawCrt(CandleSet candleSet) =>
    bool on = CrtEnabled(candleSet)

    if not on
        ClearCrtNumbers(candleSet)

    int rangeIdx    = on ? CrtRangeIndex(candleSet.candles) : -1
    int confirmIdx  = on ? CrtConfirmIndex(candleSet.candles) : -1
    bool active     = on and rangeIdx >= 0 and confirmIdx >= 0

    if not active
        if not na(candleSet.crtHighLine)
            line.delete(candleSet.crtHighLine)
            candleSet.crtHighLine := na
        if not na(candleSet.crtLowLine)
            line.delete(candleSet.crtLowLine)
            candleSet.crtLowLine := na
        if not na(candleSet.crtHighLabel)
            label.delete(candleSet.crtHighLabel)
            candleSet.crtHighLabel := na
        if not na(candleSet.crtLowLabel)
            label.delete(candleSet.crtLowLabel)
            candleSet.crtLowLabel := na

    if active
        Candle rangeCandle      = array.get(candleSet.candles, rangeIdx)
        Candle confirmCandle    = array.get(candleSet.candles, confirmIdx)
        // [merge] the left end can snap to candle 1's own wick column, so the level starts on the candle that
        // defines it instead of floating in the bars before it
        int left                = settings.crt_from_wick ? line.get_x1(rangeCandle.wick_up) : box.get_left(rangeCandle.body) - settings.crt_pad
        // [merge] the right end is what the level is read against, so it is placed exactly:
        //   'Wick of candle 2' -> line.get_x1(wick) of the candle that swept the range, i.e. the wick's own column
        //   'Whole row'        -> out to the newest candle of the row (+ padding)
        //   'Range candle'     -> just past candle 1 (+ padding)
        int right               = settings.crt_reach == 'Wick of candle 2' ? line.get_x1(confirmCandle.wick_up) : settings.crt_reach == 'Whole row' ? box.get_right(array.first(candleSet.candles).body) + settings.crt_pad : box.get_right(rangeCandle.body) + settings.crt_pad
        // when the line stops on the wick, the tag is nudged just past it so it never sits on the candle
        int labelGap            = settings.crt_reach == 'Wick of candle 2' ? math.max(settings.crt_pad, 1) : 0
        // the levels are drawn where the candle actually is on screen, the engine itself works on real prices
        float drawnHigh     = CandleY(rangeCandle, rangeCandle.h)
        float drawnLow      = CandleY(rangeCandle, rangeCandle.l)
        bool rightSide      = settings.crt_label_pos == 'Right of line'
        int highX           = rightSide ? right + labelGap : int(math.avg(box.get_left(rangeCandle.body), box.get_right(rangeCandle.body)))
        int lowX            = highX
        string highStyle    = rightSide ? label.style_label_left : label.style_label_down
        string lowStyle     = rightSide ? label.style_label_left : label.style_label_up

        if na(candleSet.crtHighLine)
            candleSet.crtHighLine := line.new(left, drawnHigh, right, drawnHigh, xloc = xloc.bar_index, color = settings.crt_high_color, style = LineStyle(settings.crt_style), width = settings.crt_width)
        line.set_xy1(candleSet.crtHighLine, left, drawnHigh)
        line.set_xy2(candleSet.crtHighLine, right, drawnHigh)
        line.set_color(candleSet.crtHighLine, settings.crt_high_color)
        line.set_style(candleSet.crtHighLine, LineStyle(settings.crt_style))
        line.set_width(candleSet.crtHighLine, settings.crt_width)

        if na(candleSet.crtLowLine)
            candleSet.crtLowLine := line.new(left, drawnLow, right, drawnLow, xloc = xloc.bar_index, color = settings.crt_low_color, style = LineStyle(settings.crt_style), width = settings.crt_width)
        line.set_xy1(candleSet.crtLowLine, left, drawnLow)
        line.set_xy2(candleSet.crtLowLine, right, drawnLow)
        line.set_color(candleSet.crtLowLine, settings.crt_low_color)
        line.set_style(candleSet.crtLowLine, LineStyle(settings.crt_style))
        line.set_width(candleSet.crtLowLine, settings.crt_width)

        if na(candleSet.crtHighLabel)
            candleSet.crtHighLabel := label.new(highX, drawnHigh, 'CRT-H', color = color_transparent, textcolor = settings.crt_high_color, style = highStyle, size = settings.crt_size)
        label.set_xy(candleSet.crtHighLabel, highX, drawnHigh)
        label.set_style(candleSet.crtHighLabel, highStyle)
        label.set_textcolor(candleSet.crtHighLabel, settings.crt_high_color)
        label.set_size(candleSet.crtHighLabel, settings.crt_size)

        if na(candleSet.crtLowLabel)
            candleSet.crtLowLabel := label.new(lowX, drawnLow, 'CRT-L', color = color_transparent, textcolor = settings.crt_low_color, style = lowStyle, size = settings.crt_size)
        label.set_xy(candleSet.crtLowLabel, lowX, drawnLow)
        label.set_style(candleSet.crtLowLabel, lowStyle)
        label.set_textcolor(candleSet.crtLowLabel, settings.crt_low_color)
        label.set_size(candleSet.crtLowLabel, settings.crt_size)

// @function            move one set of candles to its slot to the right of the price, oldest to newest
Reorder(CandleSet candleSet, int offset, array<int> active) =>
    int size        = array.size(candleSet.candles)
    int halfWidth   = int(settings.width / 2)

    if size > 0
        for i = 0 to size - 1
            Candle candle   = array.get(candleSet.candles, i)
            int t_buffer    = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + halfWidth + t_buffer)
            line.set_x2(candle.wick_up, bar_index + halfWidth + t_buffer)
            line.set_x1(candle.wick_down, bar_index + halfWidth + t_buffer)
            line.set_x2(candle.wick_down, bar_index + halfWidth + t_buffer)

            // [v6] "create if missing, then always move it": an if/else whose one block ends with a label and
            // the other with a void call is rejected (CE10235)
            if settings.daily_name
                if na(candle.dow_label)
                    candle.dow_label := label.new(bar_index + halfWidth + t_buffer, CandleY(candle, candle.h), candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size = settings.dow_size)
                label.set_y(candle.dow_label, CandleY(candle, candle.h))
                label.set_x(candle.dow_label, bar_index + halfWidth + t_buffer)
                label.set_text(candle.dow_label, candle.dow)
            if not settings.daily_name and not na(candle.dow_label)
                label.delete(candle.dow_label)
                candle.dow_label := na

            // CRT number badge, printed inside the body of candle 1 / candle 2
            if candle.crt_num > 0 and settings.crt_num_show
                int numX    = int(math.avg(box.get_left(candle.body), box.get_right(candle.body)))
                float numY  = math.avg(box.get_top(candle.body), box.get_bottom(candle.body))
                if na(candle.crt_label)
                    candle.crt_label := label.new(numX, numY, str.tostring(candle.crt_num), color = color_transparent, textcolor = settings.crt_num_color, style = label.style_label_center, size = settings.crt_num_size)
                label.set_xy(candle.crt_label, numX, numY)
                label.set_text(candle.crt_label, str.tostring(candle.crt_num))
                label.set_textcolor(candle.crt_label, settings.crt_num_color)
                label.set_size(candle.crt_label, settings.crt_num_size)
            if (candle.crt_num == 0 or not settings.crt_num_show) and not na(candle.crt_label)
                label.delete(candle.crt_label)
                candle.crt_label := na

    float top       = 0.0
    float bottom    = 0.0

    if settings.label_alignment == 'Align'
        top     := ActiveHigh(active)
        bottom  := ActiveLow(active, top)
    if settings.label_alignment == 'Follow Candles'
        top     := CandleSetHigh(candleSet.candles, 0)
        bottom  := CandleSetLow(candleSet.candles, top)

    int left = bar_index + offset + int((settings.width + settings.buffer) * (size - 1) / 2)

    if settings.htf_label_show
        string htfName  = HTFName(candleSet.settings.htf)
        string lblt     = htfName
        string lbll     = htfName
        if settings.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
        if settings.daily_name
            lblt := lblt + '\n'

        string tmr = '(' + RemainingTime(candleSet.settings.htf) + ')' + (settings.daily_name ? '\n' : '')

        if settings.label_position == 'Both' or settings.label_position == 'Top'
            // [v6] create if missing, then always move it (see the dow_label comment above)
            if na(candleSet.tfNameTop)
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size)
            label.set_xy(candleSet.tfNameTop, left, top)
            if settings.htf_timer_show
                if na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_down, size = settings.htf_timer_size)
                label.set_xy(candleSet.tfTimerTop, left, top)

        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            // [v6] create if missing, then always move it (see the dow_label comment above)
            if na(candleSet.tfNameBottom)
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size)
            label.set_xy(candleSet.tfNameBottom, left, bottom)
            if settings.htf_timer_show
                if na(candleSet.tfTimerBottom)
                    candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size)
                label.set_xy(candleSet.tfTimerBottom, left, bottom)

    // the labels were switched off, remove whatever is left of them
    if not settings.htf_label_show
        if not na(candleSet.tfNameTop)
            label.delete(candleSet.tfNameTop)
            candleSet.tfNameTop := na
        if not na(candleSet.tfNameBottom)
            label.delete(candleSet.tfNameBottom)
            candleSet.tfNameBottom := na
        if not na(candleSet.tfTimerTop)
            label.delete(candleSet.tfTimerTop)
            candleSet.tfTimerTop := na
        if not na(candleSet.tfTimerBottom)
            label.delete(candleSet.tfTimerBottom)
            candleSet.tfTimerBottom := na

    // the CRT levels ride along with the row, so they are refreshed with the same coordinates
    DrawCrt(candleSet)

// @function            refresh the remaining-time labels of one set
UpdateTime(CandleSet candleSet) =>
    if settings.htf_timer_show and (barstate.isrealtime or barstate.islast)
        string tmr = '(' + RemainingTime(candleSet.settings.htf) + ')'
        if not na(candleSet.tfTimerTop)
            label.set_text(candleSet.tfTimerTop, tmr)
        if not na(candleSet.tfTimerBottom)
            label.set_text(candleSet.tfTimerBottom, tmr)

// @function            fvg / volume imbalance boxes of one set
FindImbalance(CandleSet candleSet) =>
    if barstate.isrealtime or barstate.islast
        // rebuild from scratch so a half finished HTF candle can never leave a stale box behind
        if array.size(candleSet.imbalances) > 0
            for i = 0 to array.size(candleSet.imbalances) - 1
                Imbalance del = array.get(candleSet.imbalances, i)
                box.delete(del.b)
                label.delete(del.lbl)
            array.clear(candleSet.imbalances)

        color bullFvgColor = settings.fvg_color_mode == 'Bull / Bear' ? settings.fvg_bull : settings.fvg_color
        color bearFvgColor = settings.fvg_color_mode == 'Bull / Bear' ? settings.fvg_bear : settings.fvg_color
        color bullViColor  = settings.vi_color_mode == 'Bull / Bear' ? settings.vi_bull : settings.vi_color
        color bearViColor  = settings.vi_color_mode == 'Bull / Bear' ? settings.vi_bear : settings.vi_color

        if array.size(candleSet.candles) > 3 and settings.fvg_show
            for i = 0 to array.size(candleSet.candles) - 3
                Candle candle1 = array.get(candleSet.candles, i)
                Candle candle2 = array.get(candleSet.candles, i + 2)
                Candle candle3 = array.get(candleSet.candles, i + 1)

                if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    int leftX     = box.get_left(candle2.body)
                    int rightX    = box.get_right(candle1.body) + settings.imb_extend
                    float topP    = CandleY(candle2, candle2.h)
                    float botP    = CandleY(candle1, candle1.l)
                    imb.b := box.new(leftX, topP, rightX, botP, bgcolor = bullFvgColor, border_color = settings.imb_border, xloc = xloc.bar_index)
                    if settings.imb_labels
                        imb.lbl := label.new(int(math.avg(leftX, rightX)), math.avg(topP, botP), 'FVG', color = color_transparent, textcolor = IMBALANCE_TAG_COLOR, style = label.style_label_center, size = size.tiny)
                    array.push(candleSet.imbalances, imb)
                if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    int leftX     = box.get_right(candle1.body) - settings.imb_extend
                    int rightX    = box.get_left(candle2.body)
                    float topP    = CandleY(candle2, candle2.l)
                    float botP    = CandleY(candle1, candle1.h)
                    imb.b := box.new(leftX, topP, rightX, botP, bgcolor = bearFvgColor, border_color = settings.imb_border, xloc = xloc.bar_index)
                    if settings.imb_labels
                        imb.lbl := label.new(int(math.avg(leftX, rightX)), math.avg(topP, botP), 'FVG', color = color_transparent, textcolor = IMBALANCE_TAG_COLOR, style = label.style_label_center, size = size.tiny)
                    array.push(candleSet.imbalances, imb)

                // kept from the original: candle3 (the candle in the middle) is re-copied every bar
                box temp = box.copy(candle3.body)
                box.delete(candle3.body)
                candle3.body := temp

        if array.size(candleSet.candles) > 2 and settings.vi_show
            for i = 0 to array.size(candleSet.candles) - 2
                Candle candle1 = array.get(candleSet.candles, i)
                Candle candle2 = array.get(candleSet.candles, i + 1)

                if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    int leftX     = box.get_left(candle2.body)
                    int rightX    = box.get_right(candle1.body) + settings.imb_extend
                    float topP    = CandleY(candle1, math.min(candle1.o, candle1.c))
                    float botP    = CandleY(candle2, math.max(candle2.o, candle2.c))
                    imb.b := box.new(leftX, topP, rightX, botP, bgcolor = bullViColor, border_color = settings.imb_border, xloc = xloc.bar_index)
                    if settings.imb_labels
                        imb.lbl := label.new(int(math.avg(leftX, rightX)), math.avg(topP, botP), 'VI', color = color_transparent, textcolor = IMBALANCE_TAG_COLOR, style = label.style_label_center, size = size.tiny)
                    array.push(candleSet.imbalances, imb)
                if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    int leftX     = box.get_right(candle1.body) - settings.imb_extend
                    int rightX    = box.get_left(candle2.body)
                    float topP    = CandleY(candle2, math.min(candle2.o, candle2.c))
                    float botP    = CandleY(candle1, math.max(candle1.o, candle1.c))
                    imb.b := box.new(leftX, topP, rightX, botP, bgcolor = bearViColor, border_color = settings.imb_border, xloc = xloc.bar_index)
                    if settings.imb_labels
                        imb.lbl := label.new(int(math.avg(leftX, rightX)), math.avg(topP, botP), 'VI', color = color_transparent, textcolor = IMBALANCE_TAG_COLOR, style = label.style_label_center, size = size.tiny)
                    array.push(candleSet.imbalances, imb)

// @function            detect a new HTF candle, open it, drop the oldest one
Monitor(CandleSet candleSet) =>
    string htf              = candleSet.settings.htf
    int HTFBarTime          = time(htf, SESSION_TZ)
    // [merge] new-bar detection without ta.change(): the six sets are driven by one loop, and a ta.* instance
    // inside it would be shared by every iteration. Each set remembers the HTF bar time it last opened on.
    bool isNewHTFCandle     = not na(HTFBarTime) and (na(candleSet.last_htf_time) or HTFBarTime != candleSet.last_htf_time)

    // [merge] custom daily open: compares New York calendar days instead of the original's offset arithmetic,
    // so the daily candle is opened exactly once per day, at the first chart bar at or after the chosen hour
    if settings.use_custom_daily and htf == '1D'
        int lastOpenTime    = array.size(candleSet.candles) > 0 ? array.first(candleSet.candles).o_time : na
        bool newNyDay       = na(lastOpenTime) or DayStamp(lastOpenTime) != DayStamp(time)

        if settings.custom_daily == 'Midnight'
            isNewHTFCandle := newNyDay
        if settings.custom_daily == '8:30' or settings.custom_daily == '9:30'
            isNewHTFCandle := newNyDay and DailyAdjust(time)

    if isNewHTFCandle
        candleSet.last_htf_time := HTFBarTime

        Candle candle        = Candle.new()
        candle.o             := open
        candle.c             := close
        candle.h             := high
        candle.l             := low
        candle.o_time        := time
        candle.o_idx         := bar_index
        candle.c_idx         := bar_index
        candle.h_idx         := bar_index
        candle.l_idx         := bar_index
        candle.dow           := IntervalText(candle.o_time, htf)
        bool bull            = candle.c > candle.o

        // [merge] optional bridge between the two modules: tint the HTF body with the SMC trend
        color bodyColor      = (settings.trend_color and theme.show_smc) ? (internalTrend.bias == BULLISH ? theme.smc_bull : theme.smc_bear) : (bull ? settings.bull_body : settings.bear_body)

        // [merge] "Candle Height" scales every drawn y coordinate around the midpoint of this candle
        float dTop  = CandleY(candle, math.max(candle.o, candle.c))
        float dBot  = CandleY(candle, math.min(candle.o, candle.c))
        float dHigh = CandleY(candle, candle.h)
        float dLow  = CandleY(candle, candle.l)

        // [merge] box.new wants top above bottom regardless of the candle direction
        candle.body := box.new(bar_index, dTop, bar_index + 2, dBot, border_color = bull ? settings.bull_border : settings.bear_border, border_width = 1, bgcolor = bodyColor)
        candle.wick_up := line.new(bar_index + 1, dHigh, bar_index, dTop, color = bull ? settings.bull_wick : settings.bear_wick)
        candle.wick_down := line.new(bar_index + 1, dBot, bar_index, dLow, color = bull ? settings.bull_wick : settings.bear_wick)

        array.unshift(candleSet.candles, candle)

        if array.size(candleSet.candles) > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            label.delete(delCandle.dow_label)
            label.delete(delCandle.crt_label)

        // -------------------------------------------------------------------------------------------------
        // CRT engine. Runs once per closed candle, with the just closed candle at index 1.
        //   no range candle yet                -> the candle before the current one becomes candle 1
        //   candle closed outside candle 1     -> the "1" moves to it, its levels and the "2" are dropped
        //   candle swept H/L of candle 1 and
        //   closed back inside its range       -> it becomes candle 2, and only now CRT-H / CRT-L are drawn
        // -------------------------------------------------------------------------------------------------
        if CrtEnabled(candleSet) and array.size(candleSet.candles) > 1
            int rangeIdx = CrtRangeIndex(candleSet.candles)

            if rangeIdx < 0
                ClearCrtNumbers(candleSet)
                // [v6] CE10137: a field of an object returned by a call cannot be assigned in place
                Candle firstRange = array.get(candleSet.candles, 1)
                firstRange.crt_num := 1
            else if rangeIdx != 1
                Candle rangeCandle  = array.get(candleSet.candles, rangeIdx)
                Candle justClosed   = array.get(candleSet.candles, 1)
                bool closedOutside  = justClosed.c > rangeCandle.h or justClosed.c < rangeCandle.l
                bool swept          = justClosed.h > rangeCandle.h or justClosed.l < rangeCandle.l
                int confirmIdx      = CrtConfirmIndex(candleSet.candles)

                if closedOutside
                    ClearCrtNumbers(candleSet)
                    justClosed.crt_num := 1
                else if swept and confirmIdx < 0
                    justClosed.crt_num := 2

// @function            refresh the newest candle of one set from the live bar, then reposition the whole set
Update(CandleSet candleSet, int offset, bool showTrace, array<int> active) =>
    if array.size(candleSet.candles) > 0
        Candle candle   = array.first(candleSet.candles)
        candle.h_idx    := high > candle.h ? bar_index : candle.h_idx
        candle.h        := high > candle.h ? high : candle.h
        candle.l_idx    := low < candle.l ? bar_index : candle.l_idx
        candle.l        := low < candle.l ? low : candle.l
        candle.c        := close
        candle.c_idx    := bar_index

        bool bull = candle.c > candle.o

        // [merge] same as box.new above: top must be the max of open/close, and the height scaling applies
        float dTop  = CandleY(candle, math.max(candle.o, candle.c))
        float dBot  = CandleY(candle, math.min(candle.o, candle.c))

        box.set_top(candle.body, dTop)
        box.set_bottom(candle.body, dBot)
        // [merge] the same optional trend tint as in Monitor()
        box.set_bgcolor(candle.body, (settings.trend_color and theme.show_smc) ? (internalTrend.bias == BULLISH ? theme.smc_bull : theme.smc_bear) : (bull ? settings.bull_body : settings.bear_body))
        box.set_border_color(candle.body, bull ? settings.bull_border : settings.bear_border)
        line.set_color(candle.wick_up, bull ? settings.bull_wick : settings.bear_wick)
        line.set_color(candle.wick_down, bull ? settings.bull_wick : settings.bear_wick)
        line.set_y1(candle.wick_up, CandleY(candle, candle.h))
        line.set_y2(candle.wick_up, dTop)
        line.set_y1(candle.wick_down, CandleY(candle, candle.l))
        line.set_y2(candle.wick_down, dBot)

        if barstate.isrealtime or barstate.islast
            Reorder(candleSet, offset, active)

            if settings.trace_show and showTrace
                if bar_index - candle.o_idx < 5000
                    if na(trace.o)
                        trace.o := line.new(candle.o_idx, candle.o, box.get_left(candle.body), candle.o, xloc = xloc.bar_index, color = settings.trace_o_color, style = LineStyle(settings.trace_o_style), width = settings.trace_o_size)
                    line.set_xy1(trace.o, candle.o_idx, candle.o)
                    line.set_xy2(trace.o, box.get_left(candle.body), candle.o)

                    if settings.label_show
                        if na(trace.o_l)
                            trace.o_l := label.new(box.get_right(candle.body), candle.o, str.tostring(candle.o), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                        label.set_xy(trace.o_l, box.get_right(candle.body), candle.o)
                        label.set_text(trace.o_l, str.tostring(candle.o))

                if bar_index - candle.c_idx < 5000
                    if na(trace.c)
                        trace.c := line.new(candle.c_idx, candle.c, box.get_left(candle.body), candle.c, xloc = xloc.bar_index, color = settings.trace_c_color, style = LineStyle(settings.trace_c_style), width = settings.trace_c_size)
                    line.set_xy1(trace.c, candle.c_idx, candle.c)
                    line.set_xy2(trace.c, box.get_left(candle.body), candle.c)

                    if settings.label_show
                        if na(trace.c_l)
                            trace.c_l := label.new(box.get_right(candle.body), candle.c, str.tostring(candle.c), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                        label.set_xy(trace.c_l, box.get_right(candle.body), candle.c)
                        label.set_text(trace.c_l, str.tostring(candle.c))

                if bar_index - candle.h_idx < 5000
                    if na(trace.h)
                        trace.h := line.new(candle.h_idx, candle.h, line.get_x1(candle.wick_up), candle.h, xloc = xloc.bar_index, color = settings.trace_h_color, style = LineStyle(settings.trace_h_style), width = settings.trace_h_size)
                    line.set_xy1(trace.h, candle.h_idx, candle.h)
                    line.set_xy2(trace.h, line.get_x1(candle.wick_up), candle.h)

                    if settings.label_show
                        if na(trace.h_l)
                            trace.h_l := label.new(box.get_right(candle.body), candle.h, str.tostring(candle.h), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                        label.set_xy(trace.h_l, box.get_right(candle.body), candle.h)
                        label.set_text(trace.h_l, str.tostring(candle.h))

                if bar_index - candle.l_idx < 5000
                    if na(trace.l)
                        trace.l := line.new(candle.l_idx, candle.l, line.get_x1(candle.wick_down), candle.l, xloc = xloc.bar_index, color = settings.trace_l_color, style = LineStyle(settings.trace_l_style), width = settings.trace_l_size)
                    line.set_xy1(trace.l, candle.l_idx, candle.l)
                    line.set_xy2(trace.l, line.get_x1(candle.wick_down), candle.l)

                    if settings.label_show
                        if na(trace.l_l)
                            trace.l_l := label.new(box.get_right(candle.body), candle.l, str.tostring(candle.l), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                        label.set_xy(trace.l_l, box.get_right(candle.body), candle.l)
                        label.set_text(trace.l_l, str.tostring(candle.l))
//+==============================================================================================================+//
//+---  9 · FUNCTIONS   ·   MODULE C · glue                                                                  ---+//
//+==============================================================================================================+//

// @function  one line of the legend for one displayed HTF set
LegendLine(CandleSet candleSet) =>
    string res = HTFName(candleSet.settings.htf) + '  ·  ' + str.tostring(array.size(candleSet.candles)) + ' candles'
    if CrtEnabled(candleSet)
        res := res + '  ·  CRT'
    if settings.fvg_show
        res := res + '  ·  FVG'
    if settings.vi_show
        res := res + '  ·  VI'
    res

// @function  one line of the legend for the SMC module
SmcLegendLine() =>
    string res = 'SMC  ·  '
    res := res + (showInternalsInput ? 'internal' : 'no internal') + ' + ' + (showStructureInput ? 'swing' : 'no swing')
    if showFairValueGapsInput
        res := res + '  ·  FVG'
    if showInternalOrderBlocksInput or showSwingOrderBlocksInput
        res := res + '  ·  OB'
    if showEqualHighsLowsInput
        res := res + '  ·  EQH/EQL'
    res

// @function  the whole Smart Money Concepts module for the current bar, returns the internal trend bias
// [merge] everything below runs inside one call so the module can be switched off as a whole
smcModule(bool newBar) =>
    if showHighLowSwingsInput or showPremiumDiscountZonesInput
        updateTrailingExtremes()

        if showHighLowSwingsInput
            drawHighLowSwings()

        if showPremiumDiscountZonesInput
            drawPremiumDiscountZones()

    // [v6] CW10003: the calls below run on EVERY bar, module switched on or off, because the functions they
    // lead to carry ta.* state (ta.highest / ta.lowest / ta.change / ta.crossover / ta.cum / timeframe.change).
    // The master switch and the display inputs only decide what is DRAWN - see the guards inside the draw
    // functions below. Calculating everything keeps those series identical to running the module alone.
    deleteFairValueGaps()

    getCurrentStructure(swingsLengthInput, false)
    getCurrentStructure(5, false, true)
    getCurrentStructure(equalHighsLowsLengthInput, true)

    displayStructure(true)
    displayStructure()

    deleteOrderBlocks(true)
    deleteOrderBlocks()

    drawFairValueGaps()

    if barstate.islastconfirmedhistory or barstate.islast
        drawOrderBlocks(true)
        drawOrderBlocks()

    if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
        if showDailyLevelsInput and not higherTimeframe('D')
            drawLevels('D', timeframe.isdaily, dailyLevelsStyleInput, dailyLevelsColorInput)

        if showWeeklyLevelsInput and not higherTimeframe('W')
            drawLevels('W', timeframe.isweekly, weeklyLevelsStyleInput, weeklyLevelsColorInput)

        if showMonthlyLevelsInput and not higherTimeframe('M')
            drawLevels('M', timeframe.ismonthly, monthlyLevelsStyleInput, monthlyLevelsColorInput)

    internalTrend.bias

//+==============================================================================================================+//
//+--- 10 · EXECUTION                                                                                        ---+//
//+==============================================================================================================+//

// --------------------------------------------------------------------------------------------------- ALERT STATE
// alertcondition() can only be called from the global scope, so the per bar alert state is mirrored into
// plain booleans here and the alertcondition() calls live at the very bottom of the script.
var bool alInternalBullishBOS        = false
var bool alInternalBearishBOS        = false
var bool alInternalBullishCHoCH      = false
var bool alInternalBearishCHoCH      = false
var bool alSwingBullishBOS           = false
var bool alSwingBearishBOS           = false
var bool alSwingBullishCHoCH         = false
var bool alSwingBearishCHoCH         = false
var bool alInternalBullishOrderBlock = false
var bool alInternalBearishOrderBlock = false
var bool alSwingBullishOrderBlock    = false
var bool alSwingBearishOrderBlock    = false
var bool alEqualHighs                = false
var bool alEqualLows                 = false
var bool alBullishFairValueGap       = false
var bool alBearishFairValueGap       = false

// ------------------------------------------------------------------------------------ MODULE B · SMART MONEY
// the SMC module runs first so the ICT candles of the same bar can already use its trend
lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
bool smcNewBar  = currentBarIndex != lastBarIndex

// the module always runs so every ta.* series inside it stays consistent; the master switch only decides what
// is drawn (guards inside the draw functions) and what alerts (the carriers below are gated by it)
int smcTrendBias = smcModule(smcNewBar)

alInternalBullishBOS := theme.show_smc and currentAlerts.internalBullishBOS
alInternalBearishBOS := theme.show_smc and currentAlerts.internalBearishBOS
alInternalBullishCHoCH := theme.show_smc and currentAlerts.internalBullishCHoCH
alInternalBearishCHoCH := theme.show_smc and currentAlerts.internalBearishCHoCH
alSwingBullishBOS := theme.show_smc and currentAlerts.swingBullishBOS
alSwingBearishBOS := theme.show_smc and currentAlerts.swingBearishBOS
alSwingBullishCHoCH := theme.show_smc and currentAlerts.swingBullishCHoCH
alSwingBearishCHoCH := theme.show_smc and currentAlerts.swingBearishCHoCH
alInternalBullishOrderBlock := theme.show_smc and currentAlerts.internalBullishOrderBlock
alInternalBearishOrderBlock := theme.show_smc and currentAlerts.internalBearishOrderBlock
alSwingBullishOrderBlock := theme.show_smc and currentAlerts.swingBullishOrderBlock
alSwingBearishOrderBlock := theme.show_smc and currentAlerts.swingBearishOrderBlock
alEqualHighs := theme.show_smc and currentAlerts.equalHighs
alEqualLows := theme.show_smc and currentAlerts.equalLows
alBullishFairValueGap := theme.show_smc and currentAlerts.bullishFairValueGap
alBearishFairValueGap := theme.show_smc and currentAlerts.bearishFairValueGap

// --------------------------------------------------------------------------------------------------- TREND CANDLES
color candleColor = smcTrendBias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(theme.show_smc and showTrendInput ? open : na, high, low, close, color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

// ------------------------------------------------------------------------------------ MODULE A · ICT HTF CANDLES
array<int> activeSets = array.new<int>()

if theme.show_ict_htf
    activeSets := ActiveSetIndexes()

    int offset = settings.offset

    for [n, i] in activeSets
        CandleSet candleSet = array.get(htfSets, i)

        // the trace lines follow the timeframe the user anchored them to
        bool showTrace = settings.trace_anchor == 'First Timeframe' ? n == 0 : n == array.size(activeSets) - 1

        UpdateTime(candleSet)
        Monitor(candleSet)
        Update(candleSet, offset, showTrace, activeSets)
        FindImbalance(candleSet)

        offset := offset + (array.size(candleSet.candles) * settings.width + (array.size(candleSet.candles) > 0 ? (array.size(candleSet.candles) - 1) * settings.buffer : 0) + settings.htf_buffer)

// --------------------------------------------------------------------------------------------------- LEGEND
var label legendLabel = na

if barstate.islast
    if settings.legend_show
        string legendText = theme.show_ict_htf ? 'ICT HTF Candles  ·  ' + str.tostring(array.size(activeSets)) + '/' + str.tostring(settings.max_sets) + ' drawn' : 'ICT HTF Candles  ·  off'

        if theme.show_ict_htf
            for i in activeSets
                legendText := legendText + '\n' + LegendLine(array.get(htfSets, i))
        else
            legendText := legendText + '\n' + '—'

        legendText := legendText + '\n────────────────────────────\n'
        legendText := legendText + (theme.show_smc ? SmcLegendLine() : 'SMC  ·  off')

        if na(legendLabel)
            legendLabel := label.new(bar_index + 1, na, legendText, xloc = xloc.bar_index, yloc = yloc.belowbar, style = label.style_label_up, color = color.new(#131722, 15), textcolor = #d1d4dc, size = size.small, textalign = text.align_left)
        label.set_text(legendLabel, legendText)
    if not settings.legend_show and not na(legendLabel)
        label.delete(legendLabel)
        legendLabel := na

//+==============================================================================================================+//
//+--- 11 · ALERTS   (MODULE B · Smart Money Concepts)                                                       ---+//
//+==============================================================================================================+//

alertcondition(alInternalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(alInternalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(alInternalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(alInternalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(alSwingBullishBOS,           'Bullish BOS',                  'Internal Bullish BOS formed')
alertcondition(alSwingBullishCHoCH,         'Bullish CHoCH',                'Internal Bullish CHoCH formed')
alertcondition(alSwingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(alSwingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')

alertcondition(alInternalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(alInternalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(alSwingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(alSwingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(alEqualHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(alEqualLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(alBullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(alBearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')
