// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// ================================================================================================================
//  9os.XLR8  —  ICT HTF Candles + Smart Money Concepts  (single-file compilation)
// ----------------------------------------------------------------------------------------------------------------
//  MODULE A · "ICT HTF Candles (fadi)"           (c) fadizeidan   License: MPL 2.0
//  MODULE B · "Smart Money Concepts [LuxAlgo]"   (c) LuxAlgo      License: CC BY-NC-SA 4.0
//             https://creativecommons.org/licenses/by-nc-sa/4.0/
//
//  Both published scripts are compiled into ONE indicator. Every line of trading logic from the two originals is
//  preserved; what changed is only the integration glue and the v5 -> v6 fixes. Differences are listed here and
//  marked inline with a "// [merge]" comment.
//
//  WHAT WAS ADDED (glue)
//    · one indicator() declaration (500 boxes / 500 lines / 500 labels, max_bars_back = 5000)
//    · "Master" group: independent on/off switches for the ICT module and the SMC module. Switching the SMC
//      module off stops its drawings and its alerts, but it keeps calculating - see the CW10003 note below
//    · "Theme" group: the SMC "Style" (Colored / Monochrome, now with editable mono colours) moved out of the
//      SMC group list so both modules share one palette reference
//    · optional bridge: paint the ICT HTF candles with the SMC internal structure trend
//    · one legend label (bottom right) summarising both modules
//    · CRT highs / lows run as a small state machine per row (see the "CRT Highs & Lows" group):
//        candle 1  = the previously closed candle, the range. It carries a "1" badge.
//        candle 2  = a later candle that SWEEPS candle 1's high or low and CLOSES back inside candle 1's
//                    range. It carries a "2" badge. Only once candle 2 exists are CRT-H / CRT-L drawn, at
//                    candle 1's extremes.
//        invalid   = the moment a candle closes outside candle 1's range, the "1" moves to that candle and the
//                    CRT levels of the old range disappear. (That is the "remove the 1 labeling" rule.)
//      Run on H1 and above by default ("Only for"), one switch per row, nothing is labelled before the sweep.
//
//  MODULE A · changes vs the original
//    · all Helper methods converted to plain functions (no receiver plumbing)
//    · the 6 HTF rows are stored in objects + one array, so the execution block is a loop instead of 6 copies
//    · "Align" HTF labels now align on the sets that are actually drawn (honours "Limit to next HTFs only" and
//      skips timeframes that are not valid on the chart timeframe)
//    · HTF candles are drawn oldest -> newest left to right (the original iterated the Reorder loop backwards;
//      with absolute coordinates both orders are identical, this one cannot silently skip)
//    · custom daily open (Midnight / 8:30 / 9:30 NY) rewritten with timestamp()+hour() maths, so it no longer
//      depends on the exact bar boundaries of the chart timeframe
//    · the "Interval Value" stamp works on every timeframe (was broken for 1D/1W/1M: it switched on a buggy
//      string->number guess and a `HTF == '1M'` branch that could never be reached)
//    · Imbalance (FVG / VI) boxes: "Single" or "Bull / Bear" colour, optional FVG / VI tag, optional extend-right
//    · "Candle Height": scales the drawn HTF candles vertically, the counterpart of "Candle Width" (1 = the true
//      range, 0.5 = half, 2 = double). Each candle scales around its own midpoint, so nothing moves sideways, and
//      at 1 the scaling is an exact no-op. The bodies, wicks, imbalance boxes, CRT levels, interval stamps, the
//      1 / 2 badges and the top/bottom labels all use the scaled coordinates; the CRT sweep / reclaim engine and
//      the trace lines with their price labels keep working on the real prices.
//    · the CRT level line is drawn wick to wick: the right end is line.get_x1() of the wick that swept the range
//      ("Line ends on") and the left end is line.get_x1() of candle 1's own wick ("Start on candle 1 wick"), so
//      the line, the range and the raid are read as one object.
//    · box.set_top / set_bottom use min/max, so bullish bodies are no longer created inverted
//    · [v6] label handling uses a "create if missing, then always move it" shape: an if/else whose one block
//      returns a label and the other returns void is a compile error in v6 (CE10235)
//    · removed the debug log.info() call and the unused HTFBuffer/offset leftovers
//
//  MODULE B · changes vs the original
//    · [v6] every generic input() became input.bool() / input.color() / input.string()
//    · [v6] LuxAlgo's `getStyle()` switch has a default branch (v6 forbids na for unique types)
//    · [v6] the order block and MTF level maths never slice an empty range and never call
//      array.max() / array.min() on an empty array
//    · [v6] the 16 alertcondition() calls were hoisted to the global scope with per-bar boolean carriers
//      (alertcondition() only works at global scope)
//    · [v6] CW10003: the module is now calculated on EVERY bar, switched on or off. A function whose series
//      depend on ta.* (ta.highest / ta.change / ta.crossover / ta.cum / timeframe.change) must not be called
//      from a branch, or its values drift. The master switch and the display inputs therefore live inside the
//      draw functions and only decide what reaches the chart (and the alerts).
//    · [v6] CE10088: a function may mutate a *field* of a global object (currentAlerts.equalLows := true) but
//      never the global variable itself. The alert carriers are therefore gated at global scope with
//      `theme.show_smc and currentAlerts.x` instead of resetting the object from inside the function
//    · [v6] the equilibrium zone is monochrome aware, like the premium and discount zones
//    · explicit na handling in updateTrailingExtremes() (same picture as the original, cannot get stuck)
//    · the order block colouring / drawing code is unchanged, including the 100 block cap and the
//      "delete mitigated blocks while iterating" behaviour
//    · drawHighLowSwings() / drawPremiumDiscountZones() only *draw* while the module is enabled
//    · the FVG alert flags are set in the same place they always were (drawFairValueGaps)
//
//  NOT BROKEN OUT (kept deliberately, both are opt-in and off by default)
//    · SMC "Fair Value Gaps" stays a chart-space feature of LuxAlgo. The ICT module has its own FVG/VI boxes at
//      every HTF Candle row. They are different features and never fight for the same pixels.
//    · SMC alerts (BOS / CHoCH / OB / EQH / EQL / FVG) stay chart-level, exactly like the original.
// ================================================================================================================

//@version=6
indicator('9os.XLR8', '9os.XLR8', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

//+==============================================================================================================+//
//+---  1 · TYPES                                                                                            ---+//
//+==============================================================================================================+//

// ------------------------------------------------------------------------------------- MODULE A · ICT HTF Candles
type Candle
    float o
    float c
    float h
    float l
    int o_time
    int o_idx
    int c_idx
    int h_idx
    int l_idx
    string dow
    box body
    line wick_up
    line wick_down
    label dow_label
    // CRT: this candle's number in the current range cycle (0 = none, 1 = range candle, 2 = manipulation)
    int crt_num
    label crt_label

type Trace
    line o
    line c
    line h
    line l
    label o_l
    label c_l
    label h_l
    label l_l

// [merge] imbalance boxes can carry an optional "FVG" / "VI" tag
type Imbalance
    box b
    label lbl

type CandleSettings
    bool show
    string htf
    int max_display
    // CRT: label the high / low of the newest closed candle of this row
    bool crt

type Settings
    int max_sets
    bool use_custom_daily
    string custom_daily
    color bull_body
    color bull_border
    color bull_wick
    color bear_body
    color bear_border
    color bear_wick
    int offset
    int buffer
    int htf_buffer
    int width
    float height
    bool daily_name
    color dow_color
    string dow_size
    bool trace_show
    color trace_o_color
    string trace_o_style
    int trace_o_size
    color trace_c_color
    string trace_c_style
    int trace_c_size
    color trace_h_color
    string trace_h_style
    int trace_h_size
    color trace_l_color
    string trace_l_style
    int trace_l_size
    string trace_anchor
    bool label_show
    color label_color
    string label_size
    string label_position
    string label_alignment
    bool fvg_show
    color fvg_color
    string fvg_color_mode
    color fvg_bull
    color fvg_bear
    bool vi_show
    color vi_color
    string vi_color_mode
    color vi_bull
    color vi_bear
    color imb_border
    int imb_extend
    bool imb_labels
    bool htf_label_show
    color htf_label_color
    string htf_label_size
    bool htf_timer_show
    color htf_timer_color
    string htf_timer_size
    // CRT engine settings (shared by every row)
    string crt_min
    string crt_reach
    bool crt_from_wick
    string crt_label_pos
    bool crt_num_show
    color crt_num_color
    string crt_num_size
    color crt_high_color
    color crt_low_color
    string crt_style
    int crt_width
    int crt_pad
    string crt_size
    // [merge] shared master switches / theme values (MODULE C · glue)
    bool trend_color
    bool legend_show

type CandleSet
    array<Candle> candles
    array<Imbalance> imbalances
    CandleSettings settings
    label tfNameTop
    label tfNameBottom
    label tfTimerTop
    label tfTimerBottom
    int last_htf_time
    line crtHighLine
    line crtLowLine
    label crtHighLabel
    label crtLowLabel

// ------------------------------------------------------------------------------- MODULE B · Smart Money Concepts
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

type trend
    int bias

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime
    int bias

// -------------------------------------------------------------------------------- MODULE C · shared settings (glue)
type Theme
    bool show_ict_htf
    bool show_smc
    string smc_style
    color smc_mono_bull
    color smc_mono_bear
    color smc_bull
    color smc_bear
    color smc_equilibrium

//+==============================================================================================================+//
//+---  2 · CONSTANTS                                                                                        ---+//
//+==============================================================================================================+//

// MODULE A
string SESSION_TZ          = 'America/New_York'
color  color_transparent   = #ffffff00
color  IMBALANCE_TAG_COLOR = #787b86

// MODULE B
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'

COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

ALL                             = 'All'
BOS                             = 'BOS'
CHOCH                           = 'CHoCH'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

ATR                             = 'Atr'
RANGE                           = 'Cumulative Mean Range'

CLOSE                           = 'Close'
HIGHLOW                         = 'High/Low'

SOLID                           = '⎯⎯⎯'
DASHED                          = '----'
DOTTED                          = '····'

// MODULE C · input groups
string group_master             = 'Master  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_theme              = 'Theme  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_htf                = 'HTF Candles  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_style              = 'Styling  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_label              = 'Label Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_imbalance          = 'Imbalance  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_trace              = 'Trace  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
string group_crt                = 'CRT Highs & Lows  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'

SMART_GROUP                     = 'SMC · Smart Money Concepts'
INTERNAL_GROUP                  = 'SMC · Real Time Internal Structure'
SWING_GROUP                     = 'SMC · Real Time Swing Structure'
BLOCKS_GROUP                    = 'SMC · Order Blocks'
EQUAL_GROUP                     = 'SMC · EQH/EQL'
GAPS_GROUP                      = 'SMC · Fair Value Gaps'
LEVELS_GROUP                    = 'SMC · Highs & Lows MTF'
ZONES_GROUP                     = 'SMC · Premium & Discount Zones'

//+==============================================================================================================+//
//+---  3 · SETTINGS OBJECTS   (created before the inputs that fill them)                                    ---+//
//+==============================================================================================================+//

Theme theme                     = Theme.new()
Settings settings               = Settings.new()

var CandleSettings SettingsHTF1 = CandleSettings.new()
var CandleSettings SettingsHTF2 = CandleSettings.new()
var CandleSettings SettingsHTF3 = CandleSettings.new()
var CandleSettings SettingsHTF4 = CandleSettings.new()
var CandleSettings SettingsHTF5 = CandleSettings.new()
var CandleSettings SettingsHTF6 = CandleSettings.new()

//+==============================================================================================================+//
//+---  4 · INPUTS   ·   4.1 master switches & theme                                                          ---+//
//+==============================================================================================================+//

theme.show_ict_htf      := input.bool(true, 'ICT HTF Candles', inline = 'master', group = group_master)
theme.show_smc          := input.bool(true, 'Smart Money Concepts', '', inline = 'master', group = group_master)

theme.smc_style         := input.string(COLORED, 'SMC style', options = [COLORED, MONOCHROME], group = group_theme)
theme.smc_mono_bull     := input.color(MONO_BULLISH, 'Monochrome bullish', group = group_theme, inline = 'mono')
theme.smc_mono_bear     := input.color(MONO_BEARISH, '', group = group_theme, inline = 'mono')

settings.trend_color    := input.bool(false, 'Colour HTF candles with the SMC structure trend', group = group_theme)
settings.legend_show    := input.bool(true, 'Show legend', group = group_theme)

//+==============================================================================================================+//
//+---  4.2 · INPUTS   ·   MODULE A · ICT HTF Candles                                                       ---+//
//+==============================================================================================================+//

SettingsHTF1.show           := input.bool(true, 'HTF 1      ', inline = 'htf1', group = group_htf)
htf_1                       = input.timeframe('5', '', inline = 'htf1', group = group_htf)
SettingsHTF1.htf            := htf_1
SettingsHTF1.max_display    := input.int(10, '', inline = 'htf1', group = group_htf, minval = 1, maxval = 100)
SettingsHTF1.crt            := input.bool(true, 'CRT-H/L', inline = 'htf1', group = group_htf, tooltip = 'Draw the CRT high / low of the newest closed candle of this row')

SettingsHTF2.show           := input.bool(true, 'HTF 2      ', inline = 'htf2', group = group_htf)
htf_2                       = input.timeframe('15', '', inline = 'htf2', group = group_htf)
SettingsHTF2.htf            := htf_2
SettingsHTF2.max_display    := input.int(10, '', inline = 'htf2', group = group_htf, minval = 1, maxval = 100)
SettingsHTF2.crt            := input.bool(true, 'CRT-H/L', inline = 'htf2', group = group_htf, tooltip = 'Draw the CRT high / low of the newest closed candle of this row')

SettingsHTF3.show           := input.bool(true, 'HTF 3      ', inline = 'htf3', group = group_htf)
htf_3                       = input.timeframe('60', '', inline = 'htf3', group = group_htf)
SettingsHTF3.htf            := htf_3
SettingsHTF3.max_display    := input.int(10, '', inline = 'htf3', group = group_htf, minval = 1, maxval = 100)
SettingsHTF3.crt            := input.bool(true, 'CRT-H/L', inline = 'htf3', group = group_htf, tooltip = 'Draw the CRT high / low of the newest closed candle of this row')

SettingsHTF4.show           := input.bool(true, 'HTF 4      ', inline = 'htf4', group = group_htf)
htf_4                       = input.timeframe('240', '', inline = 'htf4', group = group_htf)
SettingsHTF4.htf            := htf_4
SettingsHTF4.max_display    := input.int(10, '', inline = 'htf4', group = group_htf, minval = 1, maxval = 100)
SettingsHTF4.crt            := input.bool(true, 'CRT-H/L', inline = 'htf4', group = group_htf, tooltip = 'Draw the CRT high / low of the newest closed candle of this row')

SettingsHTF5.show           := input.bool(true, 'HTF 5      ', inline = 'htf5', group = group_htf)
htf_5                       = input.timeframe('1D', '', inline = 'htf5', group = group_htf)
SettingsHTF5.htf            := htf_5
SettingsHTF5.max_display    := input.int(10, '', inline = 'htf5', group = group_htf, minval = 1, maxval = 100)
SettingsHTF5.crt            := input.bool(true, 'CRT-H/L', inline = 'htf5', group = group_htf, tooltip = 'Draw the CRT high / low of the newest closed candle of this row')

SettingsHTF6.show           := input.bool(true, 'HTF 6      ', inline = 'htf6', group = group_htf)
htf_6                       = input.timeframe('1W', '', inline = 'htf6', group = group_htf)
SettingsHTF6.htf            := htf_6
SettingsHTF6.max_display    := input.int(10, '', inline = 'htf6', group = group_htf, minval = 1, maxval = 100)
SettingsHTF6.crt            := input.bool(true, 'CRT-H/L', inline = 'htf6', group = group_htf, tooltip = 'Draw the CRT high / low of the newest closed candle of this row')

settings.max_sets           := input.int(6, 'Limit to next HTFs only', minval = 1, maxval = 6, group = group_htf)
settings.use_custom_daily   := input.bool(false, 'Custom daily candle open     ', inline = 'customdaily', group = group_htf)
settings.custom_daily       := input.string('Midnight', '', options = ['Midnight', '8:30', '9:30'], inline = 'customdaily', group = group_htf)

settings.bull_body          := input.color(color.new(color.green, 10), 'Body  ', inline = 'body', group = group_style)
settings.bear_body          := input.color(color.new(color.red, 10), '', inline = 'body', group = group_style)
settings.bull_border        := input.color(color.new(color.black, 10), 'Borders', inline = 'borders', group = group_style)
settings.bear_border        := input.color(color.new(color.black, 10), '', inline = 'borders', group = group_style)
settings.bull_wick          := input.color(color.new(color.black, 10), 'Wick  ', inline = 'wick', group = group_style)
settings.bear_wick          := input.color(color.new(color.black, 10), '', inline = 'wick', group = group_style)

settings.offset             := input.int(10, 'padding from current candles', minval = 1, group = group_style)
settings.buffer             := input.int(1, 'space between candles', minval = 1, maxval = 4, group = group_style)
settings.htf_buffer         := input.int(10, 'space between Higher Timeframes', minval = 1, maxval = 10, group = group_style)
settings.width              := input.int(1, 'Candle Width', minval = 1, maxval = 4, group = group_style) * 2
settings.height             := input.float(1, 'Candle Height', minval = 0.1, maxval = 5, step = 0.05, group = group_style, tooltip = 'Vertical size of the HTF candles.\n\n1 = the true high-low range of each candle, 0.5 = half the range, 2 = double.\nThe candle is scaled around its own midpoint, so nothing moves sideways.\nThe imbalance boxes, the CRT levels, the interval stamp and the HTF labels follow the same scale.\nThe trace lines keep printing the real prices of the candle on the chart.')

settings.htf_label_show     := input.bool(true, 'HTF Label           ', group = group_label, inline = 'HTFlabel')
settings.htf_label_color    := input.color(color.new(color.black, 10), '', group = group_label, inline = 'HTFlabel')
settings.htf_label_size     := input.string(size.large, '', [size.tiny, size.small, size.normal, size.large, size.huge], group = group_label, inline = 'HTFlabel')

settings.label_position     := input.string('Both', 'Label Positions', options = ['Both', 'Top', 'Bottom'], group = group_label)
settings.label_alignment    := input.string('Align', 'Label Alignment', options = ['Align', 'Follow Candles'], group = group_label)

settings.htf_timer_show     := input.bool(true, 'Remaining time      ', inline = 'timer', group = group_label)
settings.htf_timer_color    := input.color(color.new(color.black, 10), '', inline = 'timer', group = group_label)
settings.htf_timer_size     := input.string(size.normal, '', [size.tiny, size.small, size.normal, size.large, size.huge], group = group_label, inline = 'timer')

settings.daily_name         := input.bool(false, 'Interval Value        ', group = group_label, inline = 'dow')
settings.dow_color          := input.color(color.black, '', group = group_label, inline = 'dow')
settings.dow_size           := input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], group = group_label, inline = 'dow')

settings.fvg_show           := input.bool(true, 'Fair Value Gap   ', group = group_imbalance, inline = 'fvg')
settings.fvg_color_mode     := input.string('Single', '', options = ['Single', 'Bull / Bear'], group = group_imbalance, inline = 'fvgmode')
// [merge] the original single colour is kept as the default of the "Single" mode
settings.fvg_color          := input.color(color.new(color.gray, 80), 'Fill', group = group_imbalance, inline = 'fvg')
settings.fvg_bull           := input.color(color.new(color.teal, 80), 'Bull', group = group_imbalance, inline = 'fvgbull')
settings.fvg_bear           := input.color(color.new(color.red, 80), 'Bear', group = group_imbalance, inline = 'fvgbull')

settings.vi_show            := input.bool(true, 'Volume Imbalance', group = group_imbalance, inline = 'vi')
settings.vi_color_mode      := input.string('Single', '', options = ['Single', 'Bull / Bear'], group = group_imbalance, inline = 'vimode')
settings.vi_color           := input.color(color.new(color.red, 50), 'Fill', group = group_imbalance, inline = 'vi')
settings.vi_bull            := input.color(color.new(color.teal, 50), 'Bull', group = group_imbalance, inline = 'vibull')
settings.vi_bear            := input.color(color.new(color.red, 50), 'Bear', group = group_imbalance, inline = 'vibull')

settings.imb_border         := input.color(color_transparent, 'Border', group = group_imbalance, inline = 'imb')
settings.imb_extend         := input.int(0, 'Extend right', group = group_imbalance, inline = 'imb', minval = 0, maxval = 100)
settings.imb_labels         := input.bool(false, 'FVG / VI tags', group = group_imbalance, inline = 'imb')

settings.trace_show         := input.bool(false, 'Trace lines', group = group_trace)
settings.trace_o_color      := input.color(color.new(color.gray, 50), 'Open    ', inline = '1', group = group_trace)
settings.trace_o_style      := input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '1', group = group_trace)
settings.trace_o_size       := input.int(1, '', options = [1, 2, 3, 4], inline = '1', group = group_trace)
